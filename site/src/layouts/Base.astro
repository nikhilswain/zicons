---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Toast from "../components/Toast.astro";
import { SITE } from "../config";
import { WOBBLE_CSS, wobbleDefs } from "../lib/wobble";

interface Props {
  title: string;
  description: string;
  wide?: boolean;
  image?: string;
  imageAlt?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, wide = false, image = "/og/default.png", imageAlt = "Brush-drawn zicons on sketchbook paper", jsonLd } = Astro.props;
const path = Astro.url.pathname.replace(/(index)?\.html$/, "").replace(/(.)\/$/, "$1") || "/";
const canonical = new URL(path, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
---

<!doctype html>
<html lang="en" data-theme="light" data-boil="on">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="zicons" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.x} />
    <meta name="twitter:creator" content={SITE.x} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <meta name="theme-color" content="#f4efe3" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        var theme = null;
        var boil = null;
        try {
          theme = localStorage.getItem("zicons:theme");
          boil = localStorage.getItem("zicons:boil");
          var pen = JSON.parse(localStorage.getItem("zicons:settings") || "null");
          if (pen && (pen.color !== "currentColor" || pen.size !== 24 || pen.stroke !== 1.6)) d.dataset.pen = "custom";
          if (/[?&](color|size|stroke)=/.test(location.search)) d.dataset.pen = "custom";
        } catch (e) {}
        if (theme !== "dark") theme = "light";
        d.dataset.theme = theme;
        d.dataset.boil = boil === "off" ? "off" : "on";
        window.addEventListener("pagereveal", function (e) {
          var dir = null;
          try {
            dir = sessionStorage.getItem("zicons:flip");
            sessionStorage.removeItem("zicons:flip");
          } catch (err) {}
          if (e.viewTransition && (dir === "next" || dir === "prev")) e.viewTransition.types.add(dir);
        });
      })();
    </script>
    <link rel="expect" href="#site-footer" blocking="render" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=JetBrains+Mono:wght@400;600&family=Shantell+Sans:wght,BNCE,INFM@300..800,-100..100,0..100&display=swap"
      rel="stylesheet"
    />
    <style is:inline>
      @view-transition {
        navigation: auto;
      }
    </style>
    <style is:inline set:html={WOBBLE_CSS}></style>
  </head>
  <body>
    <Fragment set:html={wobbleDefs()} />
    <Header />
    <main class:list={["mx-auto px-4 sm:px-6", wide ? "max-w-[1240px]" : "max-w-[1100px]"]}>
      <slot />
    </main>
    <Footer />
    <Toast />
  </body>
</html>
