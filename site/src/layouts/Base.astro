---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Toast from "../components/Toast.astro";
import { SITE } from "../config";
import { WOBBLE_CSS, wobbleDefs } from "../lib/wobble";

interface Props {
  title: string;
  description: string;
  wide?: boolean;
}

const { title, description, wide = false } = Astro.props;
const path = Astro.url.pathname.replace(/(index)?\.html$/, "").replace(/(.)\/$/, "$1") || "/";
const canonical = new URL(path, SITE.url).href;
---

<!doctype html>
<html lang="en" data-theme="light" data-boil="on">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#f4efe3" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        var theme = null;
        var boil = null;
        try {
          theme = localStorage.getItem("zicons:theme");
          boil = localStorage.getItem("zicons:boil");
        } catch (e) {}
        if (theme !== "light" && theme !== "dark") theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        d.dataset.theme = theme;
        d.dataset.boil = boil === "off" ? "off" : "on";
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=JetBrains+Mono:wght@400;600&family=Shantell+Sans:wght,BNCE,INFM@300..800,-100..100,0..100&display=swap"
      rel="stylesheet"
    />
    <style is:inline set:html={WOBBLE_CSS}></style>
  </head>
  <body>
    <Fragment set:html={wobbleDefs()} />
    <Header />
    <main class:list={["mx-auto px-4 sm:px-6", wide ? "max-w-[1240px]" : "max-w-[1100px]"]}>
      <slot />
    </main>
    <Footer />
    <Toast />
  </body>
</html>
